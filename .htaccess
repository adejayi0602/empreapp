# Empre Technologies — root rules (Apache / cPanel)
DirectoryIndex index.php index.html

# Friendly error page that also feeds Admin > SEO & Visibility > Redirects & 404s.
# (If the site lives in a sub-folder, change /404.php to /your-folder/404.php)
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On
# The public pages are now PHP. Old .html addresses (bookmarks, Google) forward to the new ones.
RewriteRule ^index\.html$    index.php    [R=301,L]
RewriteRule ^about\.html$    about.php    [R=301,L]
RewriteRule ^services\.html$ services.php [R=301,L]
RewriteRule ^contact\.html$  contact.php  [R=301,L]
# SEO files are generated from the admin console (SEO & Visibility)
RewriteRule ^sitemap\.xml$   sitemap.php  [L]
RewriteRule ^robots\.txt$    robots.php   [L]
RewriteRule ^llms\.txt$      llms.php     [L]
RewriteRule ^([a-f0-9]{32})\.txt$ indexnow-key.php?k=$1 [L]
</IfModule>

# Speed (a Google ranking factor): compress text and let browsers cache static files
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType image/webp "access plus 6 months"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
